# --- Required ---
MONGODB_URI=mongodb://localhost:27017/vacciprofile
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated browser origins allowed to call the API (main site + admin portal)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Optional ---
PORT=5000
NODE_ENV=production
JWT_EXPIRE=7d
# Initial admin (created only when no admin exists)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@vacciprofile.com
ADMIN_PASSWORD=

# Performance / scaling
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=2
MONGODB_AUTO_INDEX=true
# In-memory cache for anonymous GETs (public site). 0 disables it.
PUBLIC_CACHE_TTL_SECONDS=60
PUBLIC_CACHE_MAX_ENTRIES=500
PUBLIC_CACHE_BROWSER_MAX_AGE=30
TRUST_PROXY_HOPS=1
JSON_BODY_LIMIT=1mb
CSV_MAX_FILE_MB=25
ACTIVITY_LOG_RETENTION_DAYS=365
LOG_REQUESTS=false

# Public site cache refresh after CMS edits (must match REVALIDATE_SECRET on the site)
SITE_REVALIDATE_URLS=http://localhost:3000/api/revalidate
SITE_REVALIDATE_SECRET=

# Rate limits
RATE_LIMIT_LOGIN=10
RATE_LIMIT_WRITES_PER_MINUTE=300
RATE_LIMIT_HEAVY_PER_MINUTE=20

# AWS Bedrock (Knowledge Base RAG) — see docs/BEDROCK_IAM_SETUP.md
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_KNOWLEDGE_BASE_ID=
BEDROCK_MODEL_ARN=
BEDROCK_AGENTIC_MAX_ITERATIONS=
KB_TYPE=
