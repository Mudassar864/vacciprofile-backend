# Server
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/vacciprofile
JWT_SECRET=change-me
JWT_EXPIRE=7d
FRONTEND_URL=http://localhost:3000
PORTAL_URL=http://localhost:3001

# Bootstrap admin (created on first start if no admin exists)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@vacciprofile.com
ADMIN_PASSWORD=Admin@123456

# AWS Bedrock (Knowledge Base RAG)
# managed = AgenticRetrieveStream (default for AWS managed KBs)
# self-managed = RetrieveAndGenerate
KB_TYPE=managed
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_KNOWLEDGE_BASE_ID=FG7MYPLH6Q
BEDROCK_MODEL_ARN=arn:aws:bedrock:us-west-2::foundation-model/anthropic.claude-sonnet-4-6
BEDROCK_AGENTIC_MAX_ITERATIONS=5
